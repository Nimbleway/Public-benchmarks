# nimble-benchmark configuration template.
#
# Copy to .env and fill in the keys for the lanes you intend to run:
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way — never commit real keys.
# Every value below except OPENAI_API_KEY has a code default, so an
# uncommented line is an override, not a requirement.


# ---------------------------------------------------------------------------
# Required for every run
# ---------------------------------------------------------------------------

# Answer synthesis, answer grading and UMBRELA retrieval judging all go
# through OpenAI, so a run needs this key even when no OpenAI lane is
# dispatched. It gates no lane of its own.
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Per-lane API keys — set only the lanes you run
# ---------------------------------------------------------------------------

# nimble_search
NIMBLE_API_KEY=

# exa_search_auto, exa_search_fast (one key, both lanes)
EXA_API_KEY=

# parallel_search_basic, parallel_search_turbo (one key, both lanes)
PARALLEL_API_KEY=

# tavily_search_basic, tavily_search_fast (one key, both lanes)
TAVILY_API_KEY=

# firecrawl_search
FIRECRAWL_API_KEY=

# brave_search — Brave Web Search subscription token.
BRAVE_SEARCH_API_KEY=


# ---------------------------------------------------------------------------
# Models — override to re-baseline, not to diff across
# ---------------------------------------------------------------------------

# Synthesizes every lane's graded answer. OpenAI models only. Changing it
# moves the Accuracy of every row, so re-baseline rather than comparing runs
# across two values. The gpt-5 family rejects temperature=0 and is therefore
# non-deterministic; gpt-4o is the default for reproducibility.
# SYNTHESIS_MODEL=gpt-4o

# GRADER_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o-2024-08-06

# Process-wide cap on concurrent OpenAI requests across judge + grader +
# synthesis. Kept under the shared httpx pool of 128.
# OPENAI_MAX_CONCURRENCY=112


# ---------------------------------------------------------------------------
# Nimble lane
# ---------------------------------------------------------------------------

# Override only to benchmark a different Nimble-compatible host.
# NIMBLE_BASE_URL=https://sdk.nimbleway.com/v2

# The one depth-configurable lane: lite | standard | fast | deep.
# `standard` is the server's current name for the Search tier, `fast` its
# deprecated alias; `deep` means `lite` plus full_content. The Cost column
# resolves this lane's price against whichever depth the run recorded.
# NIMBLE_SEARCH_DEPTH=fast


# ---------------------------------------------------------------------------
# Client-side throttles (requests/second, per provider bucket)
# ---------------------------------------------------------------------------
# These gate the harness, not the vendor. Lowering one raises the limiter
# queue wait, which lands in request_response_time_ms but NOT in the
# published provider_response_time_ms column.

# Server caps search products at 10 RPS.
# NIMBLE_RATE_PER_SECOND=9

# Exa's documented cap is 10 QPS; shared by both Exa lanes.
# EXA_RATE_PER_SECOND=9

# Parallel's documented cap is 600/min per key; shared by both lanes.
# PARALLEL_RATE_PER_SECOND=9

# Tavily publishes no numeric QPS cap — this is a conservative default
# rather than a documented ceiling. Shared by both Tavily lanes.
# TAVILY_RATE_PER_SECOND=1

# Fits Firecrawl's Hobby plan (100/min) and up. On the Free plan (10/min)
# set 0.16.
# FIRECRAWL_RATE_PER_SECOND=1

# Brave's free tier is 1 req/sec, 2,000/month. Raise on a paid plan.
# BRAVE_RATE_PER_SECOND=1


# ---------------------------------------------------------------------------
# Per-request HTTP timeouts (seconds) — all default to 60
# ---------------------------------------------------------------------------

# EXA_TIMEOUT_S=60
# PARALLEL_TIMEOUT_S=60
# TAVILY_TIMEOUT_S=60
# BRAVE_TIMEOUT_S=60
# FIRECRAWL_TIMEOUT_S=60
