# Systems under test - only the ones you run.
NIMBLE_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
# The Claude Opus 5.5 arm and the judge run through the Claude Code CLI (`claude -p`) and use its own login.

# The judge's page fetcher uses NIMBLE_API_KEY, EXA_API_KEY and FIRECRAWL_API_KEY (each layer is skipped if it fails).

# Optional
# BENCH_TODAY=2026-11-10      # date put into instructions and judge prompts (default: today)
# JUDGE_MODEL=claude-sonnet-5-5  # judge model (default pinned)
# AUDIT_MODEL=claude-opus-5-5    # audit-sample model
# KEY_AUDIT_MODEL=claude-sonnet-5-5
# CAP_OPUS=100                # per-provider spend cap in USD for run.py (CAP_NIMBLE, CAP_EXA, CAP_PARALLEL, CAP_FIRECRAWL, CAP_GPT)
